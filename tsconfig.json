{
  "compilerOptions": {
    "target": "es5",
    "lib": ["es2015"],
    "jsx": "react",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "App.tsx"],
  "exclude": ["node_modules"]
}
